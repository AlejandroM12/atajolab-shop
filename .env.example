# Número de WhatsApp en formato internacional, sin "+", espacios ni guiones.
# Ejemplo de formato (NO es un número real): 5493704000000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública del sitio (se usa para canonical, sitemap y Open Graph).
NEXT_PUBLIC_SITE_URL=https://tienda.atajolab.dev

# Alternativa de contacto si WhatsApp no está configurado (opcional).
NEXT_PUBLIC_CONTACT_EMAIL=
